#!/usr/bin/env bash
# agent-state: per-workstream agent state (STATE/ROADMAP/DECISIONS) in a private git repo.
# Store: $AGENT_STATE_DIR (default ~/.agent-state), layout projects/<slug>/<workstream>/.
# Bash 3.2 compatible (macOS /bin/bash).
set -u

STORE="${AGENT_STATE_DIR:-$HOME/.agent-state}"
HOOK_MAX=8000

die() { echo "agent-state: $*" >&2; exit 1; }
in_git() { git rev-parse --is-inside-work-tree >/dev/null 2>&1; }
branch() { git symbolic-ref --short -q HEAD 2>/dev/null; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
host() { hostname -s 2>/dev/null || hostname; }

# owner-repo from origin (ssh, scp-style, https, local path); else main worktree dir name.
slug() {
  local url path repo owner s
  url=$(git remote get-url origin 2>/dev/null)
  if [ -n "$url" ]; then
    url=${url%/}; url=${url%.git}
    path=${url##*:}
    repo=${path##*/}
    case "$path" in
      */*) owner=${path%/*}; owner=${owner##*/}; s="$owner-$repo" ;;
      *) s=$repo ;;
    esac
  else
    s=$(basename "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")")
  fi
  printf '%s\n' "$s" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9._\n-' '-'
}

# Frontmatter value: fm FILE KEY
fm() {
  awk -v k="$2" 'NR==1 && $0!="---" {exit} NR>1 && $0=="---" {exit}
    NR>1 && index($0, k ": ")==1 {print substr($0, length(k)+3); exit}' "$1"
}

branches_of() { fm "$1" branches | tr -d '[]"'"'" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$'; }

# Workstream name whose branches include $1.
find_ws() {
  local f
  [ -n "$1" ] || return 1
  for f in "$PDIR"/*/STATE.md; do
    [ -f "$f" ] || continue
    if branches_of "$f" | grep -qxF -- "$1"; then basename "$(dirname "$f")"; return 0; fi
  done
  return 1
}

# First non-empty, non-comment line under "## Current phase".
current_phase() {
  awk '/^## /{on=($0=="## Current phase"); next} on && NF && !/^<!--/ {print; exit}' "$1"
}

setup() {
  in_git || die "not in a git repo"
  SLUG=$(slug)
  [ -n "$SLUG" ] || die "cannot derive project slug"
  PDIR="$STORE/projects/$SLUG"
}

ensure_store() {
  mkdir -p "$STORE" || die "cannot create $STORE"
  [ -d "$STORE/.git" ] || git -C "$STORE" init -q -b main || die "git init failed in $STORE"
}

valid_name() { printf '%s' "$1" | grep -qE '^[a-z0-9][a-z0-9._-]*$' || die "bad workstream name '$1' (use a-z 0-9 . _ -)"; }

cmd_index() {
  setup
  [ -d "$PDIR" ] || die "no state for $SLUG"
  local f name
  {
    echo "# $SLUG workstreams"
    echo
    echo "Generated by \`agent-state index\`. Do not edit."
    echo
    echo "| Workstream | Status | Branches | Updated | Host | Current phase |"
    echo "|---|---|---|---|---|---|"
    for f in "$PDIR"/*/STATE.md; do
      [ -f "$f" ] || continue
      name=$(basename "$(dirname "$f")")
      printf '| %s | %s | %s | %s | %s | %s |\n' "$name" "$(fm "$f" status)" \
        "$(branches_of "$f" | paste -sd ',' - | sed 's/,/, /g')" "$(fm "$f" updated)" "$(fm "$f" host)" \
        "$(current_phase "$f" | tr '|' '/')"
    done
  } > "$PDIR/INDEX.md"
}

cmd_init() {
  local name=${1:-} b ws d other
  [ -n "$name" ] || die "usage: agent-state init <name>"
  valid_name "$name"
  setup
  d="$PDIR/$name"
  [ -e "$d/STATE.md" ] && die "workstream exists: $d"
  b=$(branch)
  if [ -d "$PDIR" ] && other=$(find_ws "$b"); then die "branch $b already mapped to $other"; fi
  ensure_store
  mkdir -p "$d/phases"
  cat > "$d/STATE.md" <<EOF
---
workstream: $name
project: $SLUG
branches: [${b}]
status: active
updated: $(now)
host: $(host)
---
# $name

## Goal

## Current phase

## Done (recent)

## Next

## Open questions

## Blockers

## Resume notes
<!-- branch, commit, dirty work, running jobs, external IDs -->
EOF
  cat > "$d/ROADMAP.md" <<EOF
# Roadmap: $name

Phases in order. Tick when done. Each phase has phases/NN-name/PLAN.md and SUMMARY.md.
EOF
  cat > "$d/DECISIONS.md" <<EOF
# Decisions: $name

Append-only, newest last. Format:

## YYYY-MM-DD: <decision>
Why: <reason>
EOF
  cmd_index
  echo "$d"
}

# Add current branch to an existing workstream.
cmd_map() {
  local name=${1:-} f b other
  [ -n "$name" ] || die "usage: agent-state map <workstream>"
  setup
  f="$PDIR/$name/STATE.md"
  [ -f "$f" ] || die "no workstream $name"
  b=$(branch)
  [ -n "$b" ] || die "detached HEAD; check out a branch first"
  if other=$(find_ws "$b"); then
    [ "$other" = "$name" ] && { echo "already mapped"; return 0; }
    die "branch $b already mapped to $other"
  fi
  awk -v b="$b" 'NR>1 && !done && index($0, "branches: ")==1 {
      v=substr($0, 11); sub(/^\[/, "", v); sub(/\]$/, "", v)
      print "branches: [" (v=="" ? b : v ", " b) "]"; done=1; next } {print}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  cmd_index
  echo "mapped $b -> $name"
}

cmd_ws() { setup; find_ws "$(branch)" || exit 1; }

cmd_dir() {
  setup
  if [ -n "${1:-}" ]; then echo "$PDIR/$1"; else echo "$PDIR"; fi
}

cmd_commit() {
  local msg=${1:-"state update from $(host)"}
  [ -d "$STORE/.git" ] || die "no store at $STORE"
  git -C "$STORE" add -A || die "git add failed"
  if git -C "$STORE" diff --cached --quiet; then echo "nothing to commit"; return 0; fi
  git -C "$STORE" commit -q -m "$msg" || die "commit failed"
  git -C "$STORE" log --oneline -1
}

cmd_sync() {
  local br rc
  [ -d "$STORE/.git" ] || die "no store at $STORE"
  if ! git -C "$STORE" remote get-url origin >/dev/null 2>&1; then echo "no remote; local only"; return 0; fi
  if [ -d "$STORE/.git/rebase-merge" ] || [ -d "$STORE/.git/rebase-apply" ]; then
    die "rebase in progress in $STORE; resolve it first"
  fi
  br=$(git -C "$STORE" symbolic-ref --short HEAD) || die "store HEAD detached"
  git -C "$STORE" ls-remote --exit-code --heads origin "$br" >/dev/null 2>&1; rc=$?
  if [ $rc -eq 0 ]; then
    if ! git -C "$STORE" pull -q --rebase --autostash origin "$br"; then
      echo "agent-state: pull failed. Conflicted files:" >&2
      git -C "$STORE" diff --name-only --diff-filter=U >&2
      echo "Resolve in $STORE, run 'git rebase --continue', then rerun sync." >&2
      return 1
    fi
  elif [ $rc -ne 2 ]; then
    die "cannot reach origin"
  fi
  git -C "$STORE" push -q -u origin "$br" || die "push failed; local commits kept"
  echo "synced $br"
}

# SessionStart context. Never fails, never touches the network.
cmd_hook() {
  in_git || return 0
  SLUG=$(slug); [ -n "$SLUG" ] || return 0
  PDIR="$STORE/projects/$SLUG"
  [ -d "$PDIR" ] || return 0
  local b ws d out
  b=$(branch)
  if ws=$(find_ws "$b"); then
    d="$PDIR/$ws"
    out=$(
      echo "# Agent state: $SLUG/$ws (branch $b)"
      echo "Dir: $d"
      echo "Before ending, update it via the handoff skill (/handoff)."
      echo
      cat "$d/STATE.md"
      echo
      echo "Other files:"
      (cd "$d" && find . -name '*.md' ! -path ./STATE.md | sed 's|^\./|- |' | sort)
    )
  else
    [ -f "$PDIR/INDEX.md" ] || return 0
    out=$(
      echo "# Agent state: $SLUG"
      echo "No workstream for branch ${b:-<detached>}. Run \`agent-state init <name>\` or \`agent-state map <workstream>\`."
      echo
      cat "$PDIR/INDEX.md"
    )
  fi
  if [ ${#out} -gt $HOOK_MAX ]; then
    printf '%s\n[truncated; read files in %s]\n' "${out:0:$HOOK_MAX}" "$PDIR"
  else
    printf '%s\n' "$out"
  fi
}

usage() {
  cat <<'EOF'
usage: agent-state <command>
  hook             SessionStart context for current repo/branch (silent if none)
  init <name>      create workstream mapped to current branch
  map <name>       add current branch to existing workstream
  ws               print workstream for current branch (exit 1 if none)
  dir [name]       print project or workstream dir
  index            regenerate INDEX.md
  commit [msg]     commit all store changes
  sync             pull --rebase and push if origin exists
EOF
}

case "${1:-}" in
  hook) cmd_hook 2>/dev/null; exit 0 ;;
  init) shift; cmd_init "$@" ;;
  map) shift; cmd_map "$@" ;;
  ws) cmd_ws ;;
  dir) shift; cmd_dir "$@" ;;
  index) cmd_index ;;
  commit) shift; cmd_commit "$@" ;;
  sync) cmd_sync ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
