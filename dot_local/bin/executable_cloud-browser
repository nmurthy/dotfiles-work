#!/usr/bin/env bash
# cloud-browser start|stop|status
# Display: Xorg on the NVIDIA GPU when /etc/X11/xorg-sunshine.conf exists (Sunshine input needs a real
# server), else Xvfb. Sunshine streams it to Moonlight when installed.
D=:99
H=$HOME
L=$H/.cloud-browser/logs
PW=$H/.cloud-browser-vncpass
PROF=$H/.cloud-browser-profile
XCONF=/etc/X11/xorg-sunshine.conf
SUN_CONF=$H/.config/sunshine/sunshine.conf
mkdir -p "$L" "$H/.cloud-browser"
export DISPLAY=$D
export XDG_RUNTIME_DIR=/run/user/$(id -u)
# Start page: first line of ~/.cloud-browser/url.
URL=$(head -n1 "$H/.cloud-browser/url" 2>/dev/null)
CB_EXTRA="${CB_EXTRA---use-angle=vulkan --use-gl=angle --enable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE --ignore-gpu-blocklist --enable-gpu-rasterization}"
alive() { pgrep -u "$(id -u)" -f "$1" >/dev/null; }
# Xorg runs as root; match it by display argument.
xorg_pid() { for p in $(pgrep -x Xorg); do ps -o args= -p "$p" | grep -q " $D " && echo "$p"; done; }
x_up() { xdpyinfo -display $D >/dev/null 2>&1; }
# Each launch is a plain `cmd &`: backgrounding an `a || b` list leaves a subshell holding stdout.
start() {
  [ -s "$PW" ] || { (umask 077; head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 12 > "$PW"); }
  chmod 600 "$PW"
  x11vnc -storepasswd "$(cat "$PW")" "$H/.cloud-browser/vncauth" >/dev/null 2>&1; chmod 600 "$H/.cloud-browser/vncauth"
  if ! x_up; then
    if [ -f "$XCONF" ]; then
      sudo -n rm -f /tmp/.X99-lock /tmp/.X11-unix/X99
      sudo -n setsid nohup Xorg $D -config "$(basename "$XCONF")" -noreset -nolisten tcp \
        -logfile "$L/Xorg.log" vt7 >"$L/xorg.out" 2>&1 </dev/null &
    else
      rm -f /tmp/.X99-lock
      setsid nohup Xvfb $D -screen 0 1920x1080x24 -nolisten tcp >"$L/xvfb.log" 2>&1 </dev/null &
    fi
    for _ in $(seq 20); do x_up && break; sleep 0.5; done
  fi
  if ! alive fluxbox; then setsid nohup fluxbox >"$L/fluxbox.log" 2>&1 </dev/null & fi
  if ! alive "x11vnc .*-rfbport 5900"; then
    setsid nohup x11vnc -display $D -rfbport 5900 -localhost -rfbauth "$H/.cloud-browser/vncauth" -forever -shared -noxdamage >"$L/x11vnc.log" 2>&1 </dev/null &
  fi
  if ! alive "websockify .*6080"; then
    setsid nohup websockify --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900 >"$L/novnc.log" 2>&1 </dev/null &
  fi
  if ! curl -s http://127.0.0.1:9222/json/version >/dev/null; then
    rm -f "$PROF"/Singleton*
    setsid nohup google-chrome --user-data-dir="$PROF" --no-first-run --no-default-browser-check --start-maximized \
      --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 $CB_EXTRA \
      "${URL:-about:blank}" >"$L/chrome.log" 2>&1 </dev/null &
  fi
  if command -v sunshine >/dev/null && [ -f "$SUN_CONF" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    # Audio for the stream; Sunshine adds its own null sink.
    pulseaudio --check 2>/dev/null || pulseaudio --start --exit-idle-time=-1 --log-target=file:"$L/pulse.log"
    if ! pgrep -u "$(id -u)" -x sunshine >/dev/null; then
      setsid nohup sunshine "$SUN_CONF" >"$L/sunshine.log" 2>&1 </dev/null &
    fi
  fi
  sleep 3; status
}
stop() {
  pkill -u "$(id -u)" -x sunshine
  pkill -u "$(id -u)" -f "user-data-dir=$PROF"; pkill -u "$(id -u)" -f "websockify .*6080"
  pkill -u "$(id -u)" -f "x11vnc .*-rfbport 5900"; pkill -u "$(id -u)" -x fluxbox; pkill -u "$(id -u)" -f "Xvfb $D "
  p=$(xorg_pid); [ -n "$p" ] && sudo -n kill $p
  echo stopped
}
status() {
  if [ -n "$(xorg_pid)" ]; then echo "up   Xorg $D"; elif alive "Xvfb $D "; then echo "up   Xvfb $D"; else echo "DOWN X $D"; fi
  for p in fluxbox "x11vnc .*-rfbport 5900" "websockify .*6080" "user-data-dir=$PROF"; do
    alive "$p" && echo "up   $p" || echo "DOWN $p"; done
  if command -v sunshine >/dev/null; then
    pgrep -u "$(id -u)" -x sunshine >/dev/null && echo "up   sunshine" || echo "DOWN sunshine"
  fi
}
case "$1" in start) start;; stop) stop;; status) status;; *) echo "usage: $0 start|stop|status"; exit 1;; esac
